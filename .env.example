# Copy this file to ".env" (run_docker.bat does it for you) and fill it in. Never share or upload .env.

# --- VPN (Mullvad, WireGuard). mullvad.net > Account > WireGuard configuration > generate a key and
# download a config file. Copy two lines from it:
#   PrivateKey = ....   -> WIREGUARD_PRIVATE_KEY
#   Address = 10.x.x.x/32,...   -> WIREGUARD_ADDRESSES (the first, IPv4, address is enough)
VPN_SERVICE_PROVIDER=mullvad
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
VPN_CITY=Melbourne

# --- Endpoints the bot may use (name=address of a VPN container's proxy). One is enough.
BOT_ENDPOINTS=melbourne=http://vpn:8888
BOT_ENDPOINT=

# --- Discord and other secrets (the same names the cloud copy uses in GitHub Secrets)
DISCORD_WEBHOOK_BOXES=
DISCORD_WEBHOOK_SINGLES=
DISCORD_WEBHOOK_SEALED=
DISCORD_WEBHOOK_STATUS=
DISCORD_BOT_TOKEN=
# DISCORD_WEBHOOK_INSTORE=  DISCORD_WEBHOOK_EBAY=  DISCORD_WEBHOOK_DROPS=  DISCORD_PING=
# NTFY_TOPIC=  HEARTBEAT_TOPIC=  EBAY_CLIENT_ID=  EBAY_CLIENT_SECRET=  POKEMON_WEBHOOKS=  POKEMON_PING=

# --- Container
BOT_BASE_IMAGE=python:3.12-slim-bookworm
BOT_MEMORY=768m
BOT_CPUS=1.5
BOT_EVERY_MINUTES=5
TZ=Australia/Melbourne
